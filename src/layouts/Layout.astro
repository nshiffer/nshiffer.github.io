---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="AVMep-jxAt5tinw5rPERYAuUPVt-Bgt_SKqYT1fsaWI" />
    <meta name="description" content="Nick Shiffer — Senior AI Engineer and founder. Building LLM-powered products, PourMath, LinkStreaks, and author of three books on generative AI." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-bg text-text font-body antialiased">
    <slot />
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
