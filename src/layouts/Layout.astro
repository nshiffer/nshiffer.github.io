---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = 'Nick Shiffer is a senior AI engineer and founder building LLM products, developer tools, and practical SaaS.', noindex = false } = Astro.props;
const canonical = Astro.site ?? new URL('https://nshiffer.github.io');
const canonicalUrl = new URL(Astro.url.pathname, canonical).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${canonical.origin}/#person`,
      name: 'Nick Shiffer',
      url: canonical.origin,
      jobTitle: 'Senior AI Engineer and Founder',
      sameAs: ['https://github.com/nshiffer', 'https://www.linkedin.com/in/nicholas-shiffer-9593a6175'],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonical.origin}/#website`,
      url: canonical.origin,
      name: 'Nick Shiffer',
      description,
      publisher: { '@id': `${canonical.origin}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="AVMep-jxAt5tinw5rPERYAuUPVt-Bgt_SKqYT1fsaWI" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="author" content="Nick Shiffer" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Nick Shiffer" />
    <meta property="og:image" content={`${canonical.origin}/og-image.png`} />
    <meta property="og:image:alt" content="Nick Shiffer — Senior AI Engineer and Founder" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${canonical.origin}/og-image.png`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-bg text-text font-body antialiased">
    <slot />
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
