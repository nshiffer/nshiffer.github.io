---
import { skills } from '../data/site';
---

<section id="about" class="py-24 md:py-32 px-8 md:px-16 lg:px-24 reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out border-t border-border">
  <p class="font-mono text-accent text-xs tracking-widest mb-12">[SYSTEM_PROMPT]</p>

  <div class="border border-border bg-surface p-6 md:p-8 overflow-x-auto">
    <pre class="font-mono text-sm leading-relaxed text-muted whitespace-pre-wrap">{'{'}
  <span class="text-white">"role"</span>: <span class="text-accent">"system"</span>,
  <span class="text-white">"content"</span>: <span class="text-accent">"You are talking to Nick Shiffer — an AI/full-stack
    engineer who ships LLM-powered products end to end.
    Building AI features by day, SaaS products by night.
    Previously: founder, penetration tester. Author of
    three books on generative AI. Responds best to
    interesting problems."</span>
{'}'}</pre>
  </div>

  <p class="font-mono text-muted text-xs tracking-widest mt-20 mb-8">// tools available in this context</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-border">
    {skills.map((skill, i) => (
      <div class="bg-bg p-8 hover:bg-surface transition-colors duration-200">
        <p class="font-mono text-xs text-muted mb-4">tool_0{i + 1}</p>
        <h3 class="font-mono font-medium text-accent text-base mb-3">{skill.name}()</h3>
        <p class="font-body text-sm text-muted leading-relaxed">{skill.description}</p>
      </div>
    ))}
  </div>
</section>
