---
interface Props {
  name: string;
  role: string;
  description: string;
  url: string;
  accentColor: string;
  align?: 'left' | 'right';
}

const { name, role, description, url, accentColor, align = 'left' } = Astro.props;
const alignClass = align === 'right' ? 'md:text-right md:ml-auto' : 'md:text-left';
---

<section class="min-h-screen flex items-center py-24 px-6 md:px-12 lg:px-24 reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out">
  <div class={`max-w-3xl ${alignClass}`}>
    <p class="text-sm font-medium tracking-widest uppercase mb-4" style={`color: ${accentColor}`}>
      {role}
    </p>
    <h2 class="font-display font-black text-5xl sm:text-7xl md:text-8xl leading-[0.9] tracking-tight text-white mb-6">
      {name}
    </h2>
    <p class="text-lg md:text-xl text-gray-400 font-light leading-relaxed max-w-xl mb-8">
      {description}
    </p>
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-sm font-medium tracking-wider uppercase transition-colors hover:text-white"
      style={`color: ${accentColor}`}
    >
      Visit {name}
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</section>
