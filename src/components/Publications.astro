---
const books = [
  {
    title: 'Mastering the Art of Generative Design',
    url: 'https://www.amazon.com/Mastering-Art-Generative-Comprehensive-Engineering/dp/B0C47DWL9C',
  },
  {
    title: 'Prompt Engineers Cookbook',
    url: 'https://www.amazon.com/Prompt-Engineers-Cookbook-Mastering-Generative-ebook/dp/B0C63VN3CT',
  },
  {
    title: 'AI Unleashed',
    url: 'https://www.amazon.com/AI-Unleased-Turbocharge-Business-Generative/dp/B0C87VK67Q',
  },
];
---

<section id="writing" class="py-24 md:py-32 px-8 md:px-16 lg:px-24 reveal-section opacity-0 translate-y-8 transition-all duration-700 ease-out border-t border-border">
  <p class="font-mono text-accent text-xs tracking-widest mb-12">[WRITING]</p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border">
    {books.map((book) => (
      <a
        href={book.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group block bg-bg p-8 hover:bg-surface transition-colors duration-200"
      >
        <h3 class="font-display font-bold text-base text-white mb-4 group-hover:text-accent transition-colors duration-200 leading-snug">
          {book.title}
        </h3>
        <span class="font-mono text-xs text-muted group-hover:text-accent transition-colors">
          &gt; amazon →
        </span>
      </a>
    ))}
  </div>
</section>
