<section id="hero" class="relative min-h-screen flex items-center overflow-hidden bg-bg">
  <!-- Dot grid background -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="
      background-image: radial-gradient(circle, #1f1f1f 1px, transparent 1px);
      background-size: 32px 32px;
      opacity: 0.4;
    "
  ></div>

  <!-- Content -->
  <div class="relative z-10 px-8 md:px-16 lg:px-24 pt-24 pb-16">
    <p class="font-mono text-accent text-sm md:text-base mb-6 tracking-wide">
      &gt; founder. engineer. builder.
    </p>
    <h1 class="font-display font-bold text-white leading-[0.9] tracking-tight text-[clamp(3.5rem,12vw,9rem)]">
      NICK<br />SHIFFER
    </h1>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
