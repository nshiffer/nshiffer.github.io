---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Nick Shiffer" description="This page does not exist on Nick Shiffer's portfolio." noindex>
  <main class="min-h-screen flex items-center justify-center px-8">
    <section class="max-w-xl text-center">
      <p class="font-mono text-accent text-sm mb-6">404 // NOT_FOUND</p>
      <h1 class="font-display font-bold text-white text-5xl md:text-7xl mb-6">Page not found</h1>
      <p class="font-body text-muted leading-relaxed mb-10">The requested path does not exist. Return to the portfolio to browse projects and get in touch.</p>
      <a href="/" class="inline-block font-mono text-sm text-accent border border-border px-5 py-3 hover:bg-surface transition-colors">&gt; cd ~</a>
    </section>
  </main>
</Layout>
